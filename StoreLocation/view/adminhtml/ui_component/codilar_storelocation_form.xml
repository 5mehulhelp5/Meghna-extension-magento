<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">codilar_storelocation_form.codilar_storelocation_form_data_source</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Codilar\StoreLocation\Block\Adminhtml\Store\Edit\BackButton</item>

            <item name="save" xsi:type="string">Codilar\StoreLocation\Block\Adminhtml\Store\Edit\SaveButton</item>
        </item>
    </argument>
    <settings>
        <namespace>codilar_storelocation_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>
                codilar_storelocation_form.codilar_storelocation_form_data_source
            </dep>
        </deps>
    </settings>
    <dataSource name="codilar_storelocation_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">

                <item name="component" xsi:type="string">
                    Magento_Ui/js/form/provider
                </item>
            </item>
        </argument>
        <settings>
            <submitUrl path="storelocation/index/save" />
        </settings>
        <dataProvider class="Codilar\StoreLocation\Model\Store\DataProvider" name="codilar_storelocation_form_data_source">
            <settings>
                <requestFieldName>store_id</requestFieldName>
                <primaryFieldName>store_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Store Information</label>
        </settings>
        <field name="store_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>store_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Store Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="address" formElement="textarea" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Address</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="city" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">City</label>
            </settings>
        </field>
        <field name="pincode" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Pincode</label>
            </settings>
        </field>
        <field name="phone" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Phone Number</label>
            </settings>
        </field>
        <field name="opening_hours" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Opening Hours</label>
            </settings>
        </field>
        <field name="image"
               formElement="fileUploader"
               sortOrder="70">

            <settings>
                <label translate="true">Store Image</label>
                <componentType>fileUploader</componentType>
                <dataType>text</dataType>
                <dataScope>image</dataScope>
            </settings>

            <formElements>
                <fileUploader>
                    <settings>
                        <uploaderConfig>
                            <param xsi:type="url"
                                   name="url"
                                   path="storelocation/index/upload"/>
                        </uploaderConfig>
                    </settings>
                </fileUploader>
            </formElements>

        </field>
    </fieldset>
</form>
