<?php /** @var \Magento\Framework\View\Element\Template $block */ ?>
<div class="store-form-container" style="max-width: 600px; margin: 20px auto;">
    <h2>Add Store Location (via REST API with Image)</h2>

    <form id="store-api-form">
        <div style="margin-bottom: 15px;">
            <label>Store Name:</label><br>
            <input type="text" id="store-name" name="name" required style="width: 100%; padding: 8px;">
        </div>
        <div style="margin-bottom: 15px;">
            <label>Address:</label><br>
            <textarea id="store-address" name="address" required style="width: 100%; padding: 8px;"></textarea>
        </div>
        <div style="margin-bottom: 15px;">
            <label>City:</label><br>
            <input type="text" id="store-city" name="city" required style="width: 100%; padding: 8px;">
        </div>
        <div style="margin-bottom: 15px;">
            <label>Pincode:</label><br>
            <input type="text" id="store-pincode" name="pincode" required style="width: 100%; padding: 8px;">
        </div>
        <div style="margin-bottom: 15px;">
            <label>Phone:</label><br>
            <input type="text" id="store-phone" name="phone" required style="width: 100%; padding: 8px;">
        </div>
        <div style="margin-bottom: 15px;">
            <label>Opening Hours:</label><br>
            <input type="text" id="store-opening-hours" name="opening_hours" required style="width: 100%; padding: 8px;">
        </div>
        <div style="margin-bottom: 15px;">
            <label>Store Image:</label><br>
            <input type="file" id="store-image" name="image" accept="image/*">
        </div>

        <button type="submit" id="submit-btn" style="padding: 10px 20px; background: #007bdb; color: #fff; border: none;">Save Store via API</button>
    </form>

    <div id="api-response-message" style="margin-top: 15px; font-weight: bold;"></div>
</div>

<script>
    require(['jquery'], function($) {
        $('#store-api-form').on('submit', function(event) {
            event.preventDefault();

            $('#submit-btn').prop('disabled', true).text('Saving...');

            var fileInput = $('#store-image')[0];

            // Helper function to send the API request
            function sendApiRequest(imageData = null) {
                var formData = {
                    store: {
                        name: $('#store-name').val(),
                        address: $('#store-address').val(),
                        city: $('#store-city').val(),
                        pincode: $('#store-pincode').val(),
                        phone: $('#store-phone').val(),
                        opening_hours: $('#store-opening-hours').val(),
                        image: imageData // Passes base64 file data if selected
                    }
                };

                fetch('/rest/V1/stores-location', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(formData)
                })
                    .then(response => {
                        if (!response.ok) {
                            return response.json().then(err => { throw new Error(err.message || 'API Error'); });
                        }
                        return response.json();
                    })
                    .then(data => {
                        $('#api-response-message').css('color', 'green').text('Store successfully added via REST API!');
                        $('#store-api-form')[0].reset();
                    })
                    .catch(error => {
                        $('#api-response-message').css('color', 'red').text('Error: ' + error.message);
                    })
                    .finally(() => {
                        $('#submit-btn').prop('disabled', false).text('Save Store via API');
                    });
            }

            // If an image is selected, read it as Base64 first
            if (fileInput.files && fileInput.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    // e.target.result contains the full base64 data string (e.g., "data:image/png;base64,...")
                    sendApiRequest(e.target.result);
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                sendApiRequest(null);
            }
        });
    });
</script>
