<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="store_location" resource="default" engine="innodb" comment="Store Locations across India">
        <column xsi:type="int" name="store_id" unsigned="true" nullable="false" identity="true" comment="Store ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Store Name"/>
        <column xsi:type="text" name="address" nullable="false" comment="Address"/>
        <column xsi:type="varchar" name="city" nullable="false" length="100" comment="City"/>
        <column xsi:type="varchar" name="pincode" nullable="false" length="10" comment="Pincode"/>
        <column xsi:type="varchar" name="phone" nullable="false" length="50" comment="Phone Number"/>
        <column xsi:type="varchar" name="opening_hours" nullable="false" length="255" comment="Opening Hours"/>
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Store Image"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="store_id"/>
        </constraint>
    </table>
</schema>
