    <type name="Codilar\ProductEnquiry\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">productEnquiryLogger</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Codilar\ProductEnquiry\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
</config>
