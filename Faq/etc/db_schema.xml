<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="codilar_faq" resource="default" engine="innodb" comment="FAQ">
        <column xsi:type="int" name="faq_id" unsigned="true" nullable="false"
                identity="true" comment="FAQ ID"/>
        <column xsi:type="varchar" name="question" nullable="false" length="255"
                comment="Question"/>
        <column xsi:type="text" name="answer" nullable="false" comment="Answer"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="true"
                comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="faq_id"/>
        </constraint>
    </table>
</schema>
