<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote" resource="checkout" engine="innodb" comment="Sales Quote Table">
        <column xsi:type="decimal" name="applied_wallet_amount" scale="4" precision="12" unsigned="false" nullable="true" default="0.0000" comment="Applied Wallet Amount"/>
    </table>
    <table name="sales_order" resource="sales" engine="innodb" comment="Sales Order Table">
        <column xsi:type="decimal" name="applied_wallet_amount" scale="4" precision="12" unsigned="false" nullable="true" default="0.0000" comment="Applied Wallet Amount"/>
    </table>
    <table name="Codilar_loyalty_ledger" resource="default" engine="innodb" comment="Codilar Loyalty Points Ledger">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="order_increment_id" nullable="true" length="50" comment="Related Order Increment ID"/>
        <column xsi:type="varchar" name="transaction_type" nullable="false" length="50" comment="Type (e.g. earned_order)"/>
        <column xsi:type="int" name="quantity" nullable="false" comment="Points Quantity (Positive/Negative)"/>
        <column xsi:type="varchar" name="comment" nullable="true" length="255" comment="Transaction Comment"/>
        <column xsi:type="int" name="balance_after" nullable="false" comment="Resulting Balance"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Timestamp"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="Codilar_LOYALTY_LEDGER_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
    <table name="codilar_store_wallet_ledger" resource="default" engine="innodb" comment="Store Cash Wallet Ledger">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="order_increment_id" nullable="true" length="50" comment="Order Increment ID"/>
        <column xsi:type="decimal" name="amount" scale="4" precision="12" nullable="false" comment="Monetary Amount (Positive/Negative)"/>
        <column xsi:type="decimal" name="balance_after" scale="4" precision="12" nullable="false" comment="Resulting Cash Balance"/>
        <column xsi:type="varchar" name="comment" nullable="true" length="255" comment="Transaction Reason"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="CODILAR_STORE_WALLET_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
