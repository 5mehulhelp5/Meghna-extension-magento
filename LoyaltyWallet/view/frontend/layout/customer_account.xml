<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="customer-account-navigation-my-coins">
                <arguments>
                    <argument name="path" xsi:type="string">loyalty/coins/index</argument>
                    <argument name="label" xsi:type="string">My Coins</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="customer-account-navigation-store-wallet">
                <arguments>
                    <argument name="path" xsi:type="string">loyalty/wallet/index</argument>
                    <argument name="label" xsi:type="string" translate="true">My Store Wallet</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>




