<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="customer_login">

<!--        whenever the event happens execute my observer class-->

        <observer
            name="codilar_customer_login_observer"
            instance="Codilar\CustomerLogin\Observer\CustomerLoginObserver"
        />
    </event>

</config>
